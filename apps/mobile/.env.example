# CRM Healthcare Mobile App - Environment Variables
# 
# IMPORTANT:
# 1. Copy this file to .env (cp .env.example .env)
# 2. Fill in your actual API endpoint (JANGAN commit file .env!)
# 3. File .env sudah di .gitignore dan tidak akan di-commit
# 4. Untuk production, gunakan endpoint HTTPS

# Base URL untuk backend API
# Contoh development:
# API_BASE_URL=http://192.168.1.100:8080
# API_BASE_URL=http://10.0.2.2:8080  # Android emulator
# API_BASE_URL=http://localhost:8080  # iOS simulator
#
# Contoh production:
# API_BASE_URL=https://api.yourdomain.com
#
# Jangan lupa tambahkan /api/v1 di akhir jika diperlukan
API_BASE_URL=http://your-api-endpoint:8080

# Optional: Environment identifier
# ENVIRONMENT=development
# ENVIRONMENT=production