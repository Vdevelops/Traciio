# Server Configuration
PORT=8080
ENV=development
# Jika Production
# SEED_DEFAULT_ADMIN=true 
# DEFAULT_ADMIN_PASSWORD="your_password!"
CORS_ALLOWED_ORIGINS=

# ========================================
# Database Seeder Configuration
# ========================================
# CRITICAL: These are DISABLED by default for production safety
#
# DROP_TABLES - Drop all tables before migration (⚠️ DESTRUCTIVE!)
#   - Only works when ENV=development
#   - Must be explicitly set to "true" to take effect
DROP_TABLES=false

# ENABLE_SEEDERS - Run database seeders on startup
#   - Only works when ENV=development
#   - Must be explicitly set to "true" to take effect
#   - Use ONLY_ACCOUNT=true to seed only auth data
ENABLE_SEEDERS=false
# ONLY_ACCOUNT=false

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=crm_healthcare
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_ACCESS_TTL=24
JWT_REFRESH_TTL=7

# Cerebras AI Configuration
CEREBRAS_BASE_URL=https://api.cerebras.ai
CEREBRAS_API_KEY=your-cerebras-api-key-here

# Storage Configuration
STORAGE_TYPE=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=crm-healthcare-uploads
R2_PUBLIC_URL=https://cdn.yourdomain.com
STORAGE_BASE_URL=uploads

CORS_ALLOWED_ORIGINS=https://crm-demo.gilabs.id

# Rate Limiting
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_REFRESH_REQUESTS=10
RATE_LIMIT_REFRESH_WINDOW=3600
RATE_LIMIT_UPLOAD_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW=3600
RATE_LIMIT_GENERAL_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW=60
RATE_LIMIT_PUBLIC_REQUESTS=200
RATE_LIMIT_PUBLIC_WINDOW=60

# Google Calendar OAuth2
GOOGLE_CALENDAR_CLIENT_ID=your-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
# Web redirect - must be registered in Google Cloud Console > Credentials > Authorized redirect URIs
GOOGLE_CALENDAR_REDIRECT_URL=https://yourdomain.com/api/v1/google-calendar/callback
# Mobile redirect - custom URI scheme, must ALSO be registered in Google Cloud Console
# ⚠️  Go to: GCP Console > APIs & Services > Credentials > Edit OAuth Client > Add Authorized Redirect URI:
#    crmhealth://google-calendar/callback
GOOGLE_CALENDAR_MOBILE_REDIRECT_URL=
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
# Frontend URL for post-OAuth redirect (after Google callback, user is redirected here)
# e.g. https://app.gilabs.id (production) or http://localhost:3000 (development)
GOOGLE_CALENDAR_FRONTEND_URL=http://localhost:3000

# Encryption (32 bytes, base64 encoded)
ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# ========================================
# Redis Cache Configuration
# ========================================
# Enable or disable Redis caching
REDIS_ENABLED=true

# Standalone mode configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Connection pool settings
REDIS_POOL_SIZE=200
REDIS_MIN_IDLE_CONNS=50

# Cache TTL settings (in seconds)
REDIS_PERMISSIONS_TTL=300
REDIS_SESSION_TTL=1800

# ========================================
# Redis Sentinel (High Availability)
# ========================================
# Comma-separated list of sentinel addresses
# REDIS_SENTINEL_ADDRS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_SENTINEL_MASTER=mymaster

# ========================================
# Redis Cluster
# ========================================
# Comma-separated list of cluster node addresses
# REDIS_CLUSTER_ADDRS=redis1:6379,redis2:6379,redis3:6379